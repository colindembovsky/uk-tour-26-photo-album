      "html": "<div class=\"ds-glassine\"><p>Edinburgh grew along a ridge of old volcanic rock, with a castle at one end and a palace at the other.</p></div>",
      "css": ".ds-glassine{max-width:32rem;padding:2rem 2.4rem;background:linear-gradient(172deg,rgb(255 255 255/.22),transparent 30%),rgb(234 229 215/.9);color:#2b2420;border-radius:1px;box-shadow:0 1px 1px rgb(0 0 0/.18),0 6px 18px -8px rgb(0 0 0/.45)}.ds-glassine p{margin:0;font:400 1.1rem/1.68 Alegreya,Georgia,serif}.ds-glassine p::first-letter{float:left;margin:.06em .12em 0 0;font:400 3.55em/.8 Marcellus,Georgia,serif;color:#5b3442}"
    },
