  "narrative": {
    "northStar": "The Tooled Family Album",
    "overview": "The site is a physical object: a leather-bound family album lying open on a walnut table. Every surface is a material the album would really have. Walnut for the table. Tooled leather for the covers. Black card for the leaves. White-bordered prints. A translucent glassine interleaf for each city’s history. Gilt keylines and ornaments pressed into the leather tie it together. The interface recedes so the photographs lead; chrome is limited to what a bookbinder would add.",
    "keyCharacteristics": [
      "Real materials (raster walnut and leather textures), never flat CSS stand-ins.",
      "One gilt keyline grammar: a lozenge frame enclosing a city unit.",
      "One motion moment: ornaments “tooling” themselves into the leather.",
      "Prints sit slightly askew on black card with pencil captions."
    ],
    "rules": [
      {
        "name": "The One Metal Rule",
        "body": "Gilt is the only accent colour. Never add a second highlight hue; colour variety comes from the city leathers.",
        "section": "colors"
      },
      {
        "name": "The Leather Owns the City Rule",
        "body": "A city’s colour appears only where that city is named: its cover, tab, contents mark and drop cap. It is never used for generic UI.",
        "section": "colors"
      },
      {
        "name": "The Stamped Capitals Rule",
        "body": "Marcellus appears only as uppercase gilt on leather, or as the drop cap. It is never used for body text or as a heading on black card.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do take every accent from gilt (#c8a25a) and every city colour from its leather.",
      "Do build new ornaments from the 64-unit lozenge frame with `pathLength=1` keylines so they can tool in.",
      "Do keep captions short, in Alegreya italic and ≤34ch.",
      "Do reuse the textures in `docs/assets/` for any new surface; regenerate them with `scripts/textures.mjs`."
    ],
    "donts": [
      "Don't render leather, card or walnut as flat colour or CSS gradients alone.",
      "Don't add a second animated flourish; tooling is the one motion moment.",
      "Don't use `vector-effect: non-scaling-stroke` on `pathLength` ornaments; Chrome breaks the dash maths.",
      "Don't use rounded corners above 5px, glass blur, or gradient text."
    ]
  }
}