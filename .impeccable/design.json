      "html": "<figure class=\"ds-print\"><button class=\"ds-photo\" aria-label=\"Open photo\"></button><figcaption><span class=\"ds-num\">07</span>Lunch: half a chicken, no regrets.</figcaption></figure>",
      "css": ".ds-print{margin:0;padding:2rem;background:#191b19;display:grid;gap:.85rem;width:320px}.ds-photo{display:block;width:100%;aspect-ratio:3/2;border:.45rem solid #ece6d8;border-radius:1px;background:#6a5a48;transform:rotate(-.4deg);box-shadow:0 1px 1px rgb(0 0 0/.55),0 10px 24px -10px rgb(0 0 0/.85);transition:transform .45s cubic-bezier(.22,1,.36,1),box-shadow .45s cubic-bezier(.22,1,.36,1);cursor:zoom-in}.ds-photo:hover{transform:rotate(-.4deg) translateY(-3px);box-shadow:0 2px 2px rgb(0 0 0/.45),0 22px 40px -14px rgb(0 0 0/.9)}.ds-photo:focus-visible{outline:2px solid #d9bf86;outline-offset:3px}.ds-print figcaption{display:flex;gap:.7rem;align-items:baseline;font:italic 400 1.08rem/1.5 Alegreya,Georgia,serif;color:#d6cfbf}.ds-num{font:400 .82rem \"Alegreya Sans SC\",sans-serif;letter-spacing:.1em;color:#9a9383}"
